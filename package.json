{
  "name": "bifrost",
  "version": "1.32.0",
  "description": "Bifrost - Edge router with Cloudflare Workers and Hono",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:dev": "wrangler deploy --env dev",
    "tail": "wrangler tail",
    "lint": "oxlint --ignore-pattern 'scripts/**' --max-warnings=0",
    "lint:fix": "oxlint --ignore-pattern 'scripts/**' --fix --max-warnings=0",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "pnpm run lint && pnpm -C admin run lint && pnpm run format:check && pnpm run typecheck && pnpm run -r typecheck && pnpm run test:gates && pnpm run test && pnpm run -r test && pnpm run types:check && pnpm -C slackbot run types:check && pnpm -C admin run build && pnpm run benchmark:analytics && pnpm run benchmark:routing:gate && pnpm run benchmark:unified-disabled && pnpm run wrangler:check && pnpm run public:check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:coverage:all": "pnpm run test:coverage && pnpm -C shared exec vitest run --coverage && pnpm -C admin exec vitest run --coverage && pnpm -C mcp exec vitest run --coverage",
    "test:gates": "node --test scripts/*.test.mjs",
    "public:check": "node scripts/check-public-sanitization.mjs",
    "benchmark:routing": "vitest bench --run test/performance/route-lookup.bench.ts",
    "benchmark:routing:gate": "node scripts/check-routing-benchmark.mjs",
    "benchmark:analytics": "node scripts/check-analytics-performance.mjs",
    "benchmark:unified-disabled": "tsx scripts/benchmark-unified-disabled.ts",
    "wrangler:check": "wrangler deploy --dry-run --env=\"\" --outdir .wrangler/dry-run-prod && wrangler deploy --dry-run --env dev --outdir .wrangler/dry-run-dev",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 execute bifrost-analytics --local --file=./drizzle/0000_large_slipstream.sql",
    "db:migrate:prod": "wrangler d1 execute bifrost-analytics --remote --file=./drizzle/0000_large_slipstream.sql",
    "db:migrate:v1:local": "wrangler d1 execute bifrost-analytics --local --file=./drizzle/0001_add_analytics_fields.sql",
    "db:migrate:v1:prod": "wrangler d1 execute bifrost-analytics --remote --file=./drizzle/0001_add_analytics_fields.sql",
    "db:migrate:v2:local": "wrangler d1 execute bifrost-analytics --local --file=./drizzle/0002_analytics_indexes.sql",
    "db:migrate:v2:prod": "wrangler d1 execute bifrost-analytics --remote --file=./drizzle/0002_analytics_indexes.sql",
    "db:migrate:v11:local": "wrangler d1 execute DB --local --file=./drizzle/0011_unified_traffic_events.sql",
    "db:migrate:v11:prod": "wrangler d1 execute DB --remote --file=./drizzle/0011_unified_traffic_events.sql",
    "db:studio": "drizzle-kit studio",
    "prepare": "husky",
    "types:generate": "wrangler types --include-env=false",
    "types:check": "wrangler types --include-env=false --check"
  },
  "keywords": [
    "cloudflare",
    "worker",
    "hono",
    "router"
  ],
  "author": "Henry Chong",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319",
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@bifrost/shared": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.34",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@cloudflare/vitest-pool-workers": "^0.21.2",
    "@vitest/coverage-istanbul": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "drizzle-kit": "^0.31.10",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "oxlint": "^1.78.0",
    "typescript": "^5.9.3",
    "tsx": "^4.23.12",
    "vitest": "^4.1.10",
    "wrangler": "4.122.0",
    "yaml": "^2.9.0"
  },
  "pnpm": {
    "overrides": {
      "undici@>=7.0.0 <7.29.0": "7.29.0",
      "undici@>=8.0.0 <8.9.0": "8.9.0",
      "flatted": ">=3.4.2",
      "picomatch": ">=4.0.4",
      "micromatch>picomatch": "^2.3.2",
      "yaml": ">=2.8.3",
      "devalue": ">=5.6.2",
      "qs": ">=6.15.2",
      "minimatch": ">=10.2.3",
      "rollup": ">=4.59.0",
      "ajv@^6": "^6.14.0",
      "hono": ">=4.12.34",
      "@hono/node-server": ">=1.19.13",
      "path-to-regexp@>=8.0.0 <8.4.0": ">=8.4.0",
      "brace-expansion@>=5.0.0 <5.0.9": "5.0.9",
      "vite@>=7.0.0 <7.3.5": "7.3.5",
      "vite@>=8.0.0 <8.0.16": "8.0.16",
      "ip-address@<=10.3.0": "10.3.1",
      "fast-uri": ">=4.1.2",
      "nanoid@>=3.0.0 <3.3.17": "3.3.17",
      "postcss": ">=8.5.23",
      "ws@>=8.0.0 <8.21.0": "8.21.0",
      "esbuild@<=0.24.2": "0.25.12",
      "esbuild@>=0.27.3 <0.28.1": "0.28.1",
      "@babel/core@<=7.29.0": "7.29.6",
      "sharp": ">=0.35.0"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "workerd"
    ]
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "oxlint --fix --max-warnings=0",
      "biome format --write"
    ],
    "*.json": [
      "biome format --write"
    ]
  }
}
