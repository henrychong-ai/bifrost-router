# Build stage
FROM node:24-alpine AS builder

WORKDIR /app

# Install pnpm
RUN corepack enable && corepack prepare pnpm@10.28.2 --activate

# Copy workspace manifests needed for pnpm install (lockfile-only set — keeps
# this layer stable across CHANGELOG.md edits and non-dep file changes)
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./

# Copy package.json files for both shared and admin packages
COPY shared/package.json ./shared/
COPY admin/package.json ./admin/

# Install dependencies with a persistent pnpm store cache mount — even when the
# layer itself invalidates (e.g. root package.json version bump on a release
# tag), packages are served from the mount instead of re-downloaded.
RUN --mount=type=cache,id=pnpm-store,target=/root/.local/share/pnpm/store/v3 \
    pnpm install --frozen-lockfile --filter @bifrost/shared --filter bifrost-dashboard

# CHANGELOG.md is consumed by vite build (admin/src/pages/changelog.tsx imports
# it via ?raw), not by pnpm install. Copy it after install so edits don't bust
# the install layer cache.
COPY CHANGELOG.md ./

# Copy source files for both packages
COPY shared/ ./shared/
COPY admin/ ./admin/

# Build shared package first, then admin
WORKDIR /app/shared
RUN pnpm run build

WORKDIR /app/admin

# The bundle takes no environment: it calls its own origin, and the runtime
# nginx proxies /api to the Worker with the key (v1.39.0). ADMIN_API_KEY is a
# runtime env var of the container, never a build arg, so it stays out of the
# image layers and build cache entirely.
# Vite's dependency pre-bundling cache lives at node_modules/.vite — mounted
# here so it survives across builds.
RUN --mount=type=cache,id=vite-deps,target=/app/admin/node_modules/.vite \
    pnpm run build

# Production stage with Tailscale
FROM nginx:alpine

# Install Tailscale from official image (avoids Alpine repo version lag).
# --link lets BuildKit compute these layers independently and in parallel.
COPY --link --from=docker.io/tailscale/tailscale:stable /usr/local/bin/tailscale /usr/local/bin/tailscale
COPY --link --from=docker.io/tailscale/tailscale:stable /usr/local/bin/tailscaled /usr/local/bin/tailscaled

# apk package cache mount — avoids re-downloading packages on layer invalidation.
RUN --mount=type=cache,id=apk-cache,target=/var/cache/apk \
    ln -s /var/cache/apk /etc/apk/cache \
    && apk add ca-certificates iptables ip6tables \
    && mkdir -p /var/run/tailscale /var/cache/tailscale /var/lib/tailscale

# Copy built assets
COPY --link --from=builder /app/admin/dist /usr/share/nginx/html

# The nginx config template and its renderer; the start script renders it
# into conf.d at container start from the container's environment (see the
# renderer).
COPY --link admin/nginx.conf.template /etc/nginx/bifrost/default.conf.template
COPY --link admin/scripts/render-nginx-conf.sh /usr/local/bin/render-nginx-conf.sh

# Tailscale Serve, in this container, is the one way in: nginx listens only on
# a Unix socket in a root-only directory (no TCP port; tailscaled's userspace
# networking hands a tailnet connection to any port of the node to
# 127.0.0.1:<port>, so even a loopback listener was reachable around Serve),
# and trusts the identity headers Serve sets (admin/scripts/render-nginx-conf.sh).
ENV DASHBOARD_TAILSCALE_SERVE=on

# Copy startup script
COPY --link admin/scripts/start-with-tailscale.sh /start.sh
RUN chmod +x /start.sh /usr/local/bin/render-nginx-conf.sh

# The /api proxy verifies the Worker's certificate against this CA bundle
# (proxy_ssl_trusted_certificate): the build stops if it is missing.
RUN test -s /etc/ssl/certs/ca-certificates.crt

# Remove the stock nginx site: it serves the same files without the dashboard's
# CSP and security headers, so a launch that bypasses the start script must
# find no config to serve rather than that one.
RUN rm -f /etc/nginx/conf.d/default.conf

# Tailscale state directory (mount as volume for persistence)
VOLUME /var/lib/tailscale

# No EXPOSE: nginx has no TCP port here; Tailscale Serve handles HTTPS on the
# tailnet and proxies to nginx's Unix socket.

# Start with Tailscale
CMD ["/start.sh"]
