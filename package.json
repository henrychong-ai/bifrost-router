{
  "name": "bifrost",
  "version": "1.38.0",
  "description": "Bifrost - Edge router with Cloudflare Workers and Hono",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:dev": "wrangler deploy --env dev",
    "tail": "wrangler tail",
    "lint": "oxlint --max-warnings=0",
    "lint:fix": "oxlint --fix --max-warnings=0",
    "format": "biome check --write .",
    "format:check": "biome check .",
    "check": "pnpm run redaction:check && pnpm run lint && pnpm run boundary:check && pnpm -C admin run lint && pnpm run format:check && pnpm run typecheck && pnpm run -r typecheck && pnpm run test:gates && pnpm run test && pnpm run -r test && pnpm run changelog:check && pnpm run types:check && pnpm -C admin run build && pnpm run check:changelog-bundle && pnpm run check:changelog-chunk && pnpm run benchmark:analytics && pnpm run benchmark:routing:gate && pnpm run benchmark:unified-disabled && pnpm run wrangler:check && pnpm run public:check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:coverage:all": "pnpm run test:coverage && pnpm -C shared exec vitest run --coverage && pnpm -C admin exec vitest run --coverage && pnpm -C mcp exec vitest run --coverage",
    "test:gates": "node --test scripts/*.test.mjs",
    "public:check": "node scripts/check-public-sanitization.mjs",
    "boundary:check": "node scripts/check-boundary-reads.mjs",
    "changelog:generate": "node scripts/generate-changelog-module.mjs",
    "changelog:check": "node scripts/generate-changelog-module.mjs --check",
    "check:changelog-bundle": "node scripts/check-changelog-not-bundled.mjs",
    "check:changelog-chunk": "node scripts/check-changelog-chunk-size.mjs",
    "benchmark:routing": "vitest bench --run test/performance/route-lookup.bench.ts",
    "benchmark:routing:gate": "node scripts/check-routing-benchmark.mjs",
    "benchmark:analytics": "node scripts/check-analytics-performance.mjs",
    "benchmark:unified-disabled": "tsx scripts/benchmark-unified-disabled.ts",
    "wrangler:check": "wrangler deploy --dry-run --env=\"\" --outdir .wrangler/dry-run-prod && wrangler deploy --dry-run --env dev --outdir .wrangler/dry-run-dev",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 execute bifrost-analytics --local --file=./drizzle/0000_large_slipstream.sql",
    "db:migrate:prod": "wrangler d1 execute bifrost-analytics --remote --file=./drizzle/0000_large_slipstream.sql",
    "db:migrate:v1:local": "wrangler d1 execute bifrost-analytics --local --file=./drizzle/0001_add_analytics_fields.sql",
    "db:migrate:v1:prod": "wrangler d1 execute bifrost-analytics --remote --file=./drizzle/0001_add_analytics_fields.sql",
    "db:migrate:v2:local": "wrangler d1 execute bifrost-analytics --local --file=./drizzle/0002_analytics_indexes.sql",
    "db:migrate:v2:prod": "wrangler d1 execute bifrost-analytics --remote --file=./drizzle/0002_analytics_indexes.sql",
    "db:migrate:v11:local": "wrangler d1 execute DB --local --file=./drizzle/0011_unified_traffic_events.sql",
    "db:migrate:v11:prod": "wrangler d1 execute DB --remote --file=./drizzle/0011_unified_traffic_events.sql",
    "db:migrate:v12:local": "wrangler d1 execute DB --local --file=./drizzle/0012_feedback_priority_scale.sql",
    "db:migrate:v12:prod": "wrangler d1 execute DB --remote --file=./drizzle/0012_feedback_priority_scale.sql",
    "db:studio": "drizzle-kit studio",
    "prepare": "husky",
    "types:generate": "wrangler types --include-env=false",
    "types:check": "wrangler types --include-env=false --check",
    "redaction:check": "node scripts/check-credential-redaction.mjs"
  },
  "keywords": [
    "cloudflare",
    "worker",
    "hono",
    "router"
  ],
  "author": "Henry Chong",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319",
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@bifrost/shared": "workspace:*",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.12",
    "pako": "3.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@cloudflare/vitest-pool-workers": "^0.18.8",
    "@vitest/coverage-istanbul": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11",
    "drizzle-kit": "^0.31.11",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11",
    "wrangler": "4.146.0",
    "yaml": "^2.9.1"
  },
  "pnpm": {
    "overrides": {
      "undici@>=7.0.0 <7.29.1": "7.29.1",
      "undici@>=8.0.0 <8.10.2": "8.10.2",
      "flatted": ">=3.4.2",
      "picomatch": ">=4.0.4",
      "micromatch>picomatch": "^2.3.2",
      "yaml": ">=2.8.3",
      "devalue": ">=5.6.2",
      "qs": ">=6.16.0",
      "minimatch": ">=10.2.3",
      "rollup": ">=4.59.0",
      "ajv@^6": "^6.14.0",
      "hono": ">=4.13.12 <5",
      "@hono/node-server": ">=1.19.13",
      "path-to-regexp@>=8.0.0 <8.4.0": ">=8.4.0",
      "brace-expansion@>=5.0.0 <5.0.12": "5.0.12",
      "vite@>=7.0.0 <7.3.5": "7.3.5",
      "vite@>=8.0.0 <8.0.16": "8.0.16",
      "ip-address@<=10.7.0": "10.7.3",
      "fast-uri": ">=4.1.5 <5",
      "nanoid@>=3.0.0 <3.3.18": "3.3.18",
      "postcss": ">=8.5.23",
      "ws@>=8.0.0 <8.21.0": "8.21.0",
      "esbuild@<=0.24.2": "0.25.12",
      "esbuild@>=0.27.3 <0.28.1": "0.28.1",
      "@babel/core@<=7.29.0": "7.29.6",
      "sharp": ">=0.35.4",
      "source-map-js@<1.2.2": "1.2.2"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "workerd"
    ]
  }
}
