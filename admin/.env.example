# Admin dashboard settings for `pnpm dev` / `vite preview` ONLY (v1.39.0).
# Copy to admin/.env.local.
#
# The dashboard calls only its own origin. The Vite dev server proxies /api to
# DASHBOARD_DEV_API_URL and adds X-Admin-Key from DASHBOARD_DEV_ADMIN_API_KEY
# (admin/dev-api-proxy.ts), so the key stays in the dev server and never
# reaches the browser or a build. Never name it VITE_*: Vite hands every
# VITE_ variable to the browser. Containers take neither: their nginx proxies
# /api to API_PROXY_ORIGIN with the container's ADMIN_API_KEY.

# The Worker the dev server proxies /api to (default http://localhost:8787)
DASHBOARD_DEV_API_URL=http://localhost:8787

# Admin API key - matches the ADMIN_API_KEY secret on that Worker
DASHBOARD_DEV_ADMIN_API_KEY=your-admin-api-key-here
