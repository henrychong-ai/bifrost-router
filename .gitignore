# Dependencies
node_modules/
.pnpm-store/

# Wrangler (.dev.vars and per-environment .dev.vars.<env> hold local secrets)
.wrangler/
.dev.vars*
!.dev.vars.example

# Build output
dist/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Coverage reports
coverage/
.ci-artifacts/

# Environment variables (examples stay tracked)
.env
.env.*
!.env.example

# Operator credentials and state for the dashboard container: auth.env holds
# TAILSCALE_AUTHKEY and ADMIN_API_KEY; admin/tailscale/ is the Tailscale
# node state (its machine key) the compose file mounts.
auth.env
admin/tailscale/

# Coding-harness isolated worktrees (git worktree add under the repo)
.claude/worktrees/
