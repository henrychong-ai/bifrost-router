{
  "name": "@bifrost/slackbot",
  "version": "1.0.0",
  "description": "Slack integration for Bifrost - route management via Slack",
  "type": "module",
  "main": "./src/index.ts",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:dev": "wrangler deploy --env dev",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "tail": "wrangler tail",
    "types:generate": "wrangler types --include-env=false",
    "types:check": "wrangler types --include-env=false --check"
  },
  "dependencies": {
    "@bifrost/shared": "workspace:*",
    "hono": "^4.13.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.18.8",
    "@types/node": "^25.9.5",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "wrangler": "4.114.0"
  }
}
